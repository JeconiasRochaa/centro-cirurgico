        },
        "age": {
          ".validate": "newData.isNumber()"
        },
        "origem": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "clinicaOrigem": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().length <= 600"
        },
        "specialty": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "doctor": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "instrumentador": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "anesthetist": {
          ".validate": "newData.isString() && newData.val().length <= 120"
        },
        "necessitaSangue": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "necessitaUTI": {
          ".validate": "newData.isString() && newData.val().length <= 10"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "painel_espera": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'painel_espera' || root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'diretor' || root.child('users').child(auth.uid).child('role').val() === 'cirurgico')",
      "$id": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'diretor' || root.child('users').child(auth.uid).child('role').val() === 'cirurgico')",
        ".validate": "newData.hasChildren(['id','date','status']) && newData.child('id').val() === $id",
        "id": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "date": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
        },
        "time": {
          ".validate": "newData.isString() && newData.val().length <= 5"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "status": {
          ".validate": "newData.val() === 'pendente' || newData.val() === 'em_preparacao' || newData.val() === 'em_andamento' || newData.val() === 'recuperacao' || newData.val() === 'concluida' || newData.val() === 'suspensa' || newData.val() === 'cancelada'"
        },
        "patientDisplay": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
